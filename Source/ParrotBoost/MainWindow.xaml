<Window x:Class="ParrotBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ParrotBoost" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        AllowsTransparency="False"
        WindowStyle="None"
        Icon="logo.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="Fant"
        RenderOptions.EdgeMode="Unspecified">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45" GlassFrameThickness="0" CornerRadius="12" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#2D3436"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#636E72"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DFE6E9"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorPrimaryBrush" Color="#2ECC71"/>
        <SolidColorBrush x:Key="BoostButtonBorderBrush" Color="#2D3436"/>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" Direction="270" RenderingBias="Quality" ShadowDepth="1" Opacity="0.08"/>

        <Style x:Key="CrispCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant"/>
        </Style>

        <Style x:Key="RoundBoostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}" Stroke="{DynamicResource BoostButtonBorderBrush}" StrokeThickness="3.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.3" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="64" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="42" CenterY="42"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,0">
                            <ContentPresenter x:Name="content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowFrame" Background="{DynamicResource WindowBackground}" CornerRadius="12" SnapsToDevicePixels="True"/>
        <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Panel.ZIndex="10" Height="45" Background="{DynamicResource HeaderBackground}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="12,12,0,0" ClipToBounds="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Image Source="logonbg.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock Text="{DynamicResource MainWindow.Title}" Foreground="{DynamicResource TextPrimary}" Margin="12,0" FontWeight="Bold" VerticalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Click="Theme_Click" Margin="0,0,5,0" ToolTip="Switch Theme" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Click="Settings_Click" Margin="0,0,5,0" ToolTip="Settings" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button x:Name="MinimizeBtn" Style="{StaticResource IconButton}" Click="Minimize_Click" Margin="0,0,5,0" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="UpdateNotificationBar" Grid.Row="1" Background="#27AE60" Padding="14,8" Visibility="Collapsed" Panel.ZIndex="15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock x:Name="UpdateNotificationText" Text="Nowa wersja ParrotBoost jest dostępna!" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdateNowBtn" Content="Zaktualizuj" Click="UpdateNowBtn_Click" Background="White" Foreground="#1E8449" FontWeight="Bold" Padding="12,3" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                        <Button x:Name="DismissUpdateBtn" Content="✕" Click="DismissUpdateBtn_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid x:Name="MainDashboard" Margin="8" Visibility="Visible" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch" Padding="20,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0" x:Name="GpuDriverBtn" Content="Checking GPU drivers..." HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,2" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondary}" Cursor="Hand" Click="GpuDriverBtn_Click" FontSize="11"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="{DynamicResource MainWindow.Specs}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="CpuInfo" Text="CPU: Loading..." Foreground="{DynamicResource TextPrimary}" Margin="0,2" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock x:Name="GpuInfo" Text="GPU: Loading..." Foreground="{DynamicResource TextPrimary}" Margin="0,2" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock x:Name="IgpuInfo" Text="iGPU: Loading..." Foreground="{DynamicResource TextPrimary}" Margin="0,2" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>
                                        <TextBlock x:Name="RamInfo" Text="RAM: Loading..." Foreground="{DynamicResource TextPrimary}" Margin="0,2" FontSize="12"/>
                                        <TextBlock x:Name="DiskInfo" Text="Disks: Loading..." Foreground="{DynamicResource TextPrimary}" Margin="0,2" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CrispCard}" Margin="8" VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,8" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <TextBlock x:Name="BoostPercentage" Text="+5-12%" FontSize="36" FontWeight="Bold" FontFamily="Segoe UI, Segoe UI Variable Display, Arial" Foreground="{DynamicResource ColorPrimaryBrush}" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                    <TextBlock x:Name="BoostPredictionDetails" Text="{DynamicResource MainWindow.OptimizedPerformance}" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="160" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,10">
                                <Grid x:Name="LogoContainer" Width="110" Height="110" Margin="0,0,0,14">
                                    <Image Source="logonbg.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="Fant">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="24" Color="{Binding Color, Source={StaticResource ColorPrimaryBrush}}" Opacity="0.22" ShadowDepth="0"/>
                                        </Image.Effect>
                                    </Image>
                                </Grid>
                                
                                <Button x:Name="BoostButton" Content="{DynamicResource MainWindow.Boost}" 
                                        Style="{StaticResource RoundBoostButtonStyle}"
                                        Click="BoostButton_Click" Width="84" Height="84" FontSize="14"/>
                                
                                <TextBlock x:Name="ProgressStatus" Text="{DynamicResource MainWindow.ReadyToBoost}" 
                                           Margin="0,14,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="12" FontWeight="Medium"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="170"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="8" VerticalAlignment="Stretch" Padding="12,20,12,8">
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="LIVE PERFORMANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondary}" FontSize="9" FontWeight="Bold" Width="22"/>
                                            <TextBlock x:Name="CpuLoadText" Text="0%" Foreground="{DynamicResource TextPrimary}" FontSize="9" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CpuTempText" Text="--°C" Foreground="{DynamicResource TextPrimary}" FontSize="9" Margin="6,0"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="CpuLoadBar" Height="5" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource BorderBrush}" BorderThickness="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="GPU" Foreground="{DynamicResource TextSecondary}" FontSize="9" FontWeight="Bold" Width="22"/>
                                            <TextBlock x:Name="GpuLoadText" Text="0%" Foreground="{DynamicResource TextPrimary}" FontSize="9" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="GpuTempText" Text="--°C" Foreground="{DynamicResource TextPrimary}" FontSize="9" Margin="6,0"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="GpuLoadBar" Height="5" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource BorderBrush}" BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsOverlay" Background="{DynamicResource WindowBackground}" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="5" SnapsToDevicePixels="True">
                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
                            <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Click="Settings_Back_Click" Margin="0,0,15,0" ToolTip="Back">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                            </Button>
                            <TextBlock Text="{DynamicResource SettingsWindow.Title}" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="{DynamicResource SettingsWindow.General}" Style="{StaticResource TabItemStyle}" Foreground="{DynamicResource TextPrimary}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,15">
                                        <TextBlock Text="{DynamicResource SettingsWindow.AppSetting}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <CheckBox x:Name="LaunchAtStartupCheck" Content="{DynamicResource SettingsWindow.LaunchAtStartup}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="MinimizeToTrayCheck" Content="{DynamicResource SettingsWindow.MinimizeToTray}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="CheckUpdatesOnStartupCheck" Content="{DynamicResource SettingsWindow.CheckUpdatesOnStartup}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        
                                        <Button x:Name="CheckUpdatesNowButton" Content="Sprawdź aktualizacje teraz" Click="CheckUpdatesNowButton_Click" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" Width="200" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0"/>

                                        <TextBlock Text="{DynamicResource SettingsWindow.Language}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,15,0,8" FontSize="14"/>
                                        <ComboBox x:Name="LanguageSelector" Width="200" HorizontalAlignment="Left" SelectionChanged="LanguageSelector_SelectionChanged" Padding="8,5">
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                            <ComboBoxItem Content="Polski" Tag="pl-PL"/>
                                            <ComboBoxItem Content="Norsk" Tag="nb-NO"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de-DE"/>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{DynamicResource SettingsWindow.Performance}" Style="{StaticResource TabItemStyle}" Foreground="{DynamicResource TextPrimary}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,15">
                                        <TextBlock Text="{DynamicResource SettingsWindow.OptimizationSteps}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <CheckBox x:Name="OptBlockDeliveryUploadCheck" Content="{DynamicResource SettingsWindow.BlockDeliveryOptimization}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableTelemetryTasksCheck" Content="{DynamicResource SettingsWindow.DisableTelemetryTasks}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptServicesCheck" Content="{DynamicResource SettingsWindow.DisableServices}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptMemoryCheck" Content="{DynamicResource SettingsWindow.ClearMemory}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptTasksCheck" Content="Optimize Task Scheduler" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptNtfsCheck" Content="Disable NTFS Last Access" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptPriorityCheck" Content="Optimize Foreground Priority" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptUsbCheck" Content="Disable USB Power Saving" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDeliveryCheck" Content="Disable Delivery Optimization" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptTickCheck" Content="Disable Dynamic Tick" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="GameModeCheck" Content="{DynamicResource SettingsWindow.GameMode}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{DynamicResource SettingsWindow.PrivacyAI}" Style="{StaticResource TabItemStyle}" Foreground="{DynamicResource TextPrimary}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,15">
                                        <TextBlock Text="{DynamicResource SettingsWindow.PrivacyTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="OptDisableAdvertisingIdCheck" Content="{DynamicResource SettingsWindow.DisableAdvertisingId}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableDiagnosticDataCheck" Content="{DynamicResource SettingsWindow.DisableDiagnosticData}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableActivityHistoryCheck" Content="{DynamicResource SettingsWindow.DisableActivityHistory}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableLocationTrackingCheck" Content="{DynamicResource SettingsWindow.DisableLocationTracking}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableFeedbackNotificationsCheck" Content="{DynamicResource SettingsWindow.DisableFeedbackNotifications}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>

                                        <TextBlock Text="{DynamicResource SettingsWindow.AITitle}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,18,0,12"/>
                                        <CheckBox x:Name="OptDisableCopilotCheck" Content="{DynamicResource SettingsWindow.DisableCopilot}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableRecallCheck" Content="{DynamicResource SettingsWindow.DisableRecall}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableClickToDoCheck" Content="{DynamicResource SettingsWindow.DisableClickToDo}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableGenerativeSearchAiCheck" Content="{DynamicResource SettingsWindow.DisableGenerativeSearchAi}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableAppAiFeaturesCheck" Content="{DynamicResource SettingsWindow.DisableAppAiFeatures}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        <CheckBox x:Name="OptDisableEdgeAiCheck" Content="{DynamicResource SettingsWindow.DisableEdgeAi}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="{DynamicResource SettingsWindow.Cleanup}" Style="{StaticResource TabItemStyle}" Foreground="{DynamicResource TextPrimary}">
                                <Grid Margin="10,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SettingsWindow.SystemCleanup}" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <CheckBox x:Name="CleanPrefetchCheck" Content="{DynamicResource SettingsWindow.CleanPrefetch}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanTempCheck" Content="{DynamicResource SettingsWindow.CleanTemp}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanWinTempCheck" Content="{DynamicResource SettingsWindow.CleanWinTemp}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanUpdateCacheCheck" Content="{DynamicResource SettingsWindow.CleanUpdateCache}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanRecycleBinCheck" Content="{DynamicResource SettingsWindow.CleanRecycleBin}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanBrowserCacheCheck" Content="{DynamicResource SettingsWindow.CleanBrowserCache}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanThumbnailsCheck" Content="{DynamicResource SettingsWindow.CleanThumbnails}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanErrorReportingCheck" Content="{DynamicResource SettingsWindow.CleanErrorReporting}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                            <CheckBox x:Name="CleanSystemLogsCheck" Content="{DynamicResource SettingsWindow.CleanSystemLogs}" Foreground="{DynamicResource TextPrimary}" Margin="0,5" FontSize="13"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                                        <StackPanel>
                                            <TextBlock x:Name="CleanupSizeText" Text="Estimated size: 0 MB" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ScanCleanupButton" Content="{DynamicResource SettingsWindow.Scan}" Click="Scan_Click" Background="{DynamicResource ColorPrimaryBrush}" Foreground="White" Width="130" HorizontalAlignment="Left" Padding="15,8" Margin="0,0,10,0"/>
                                                <Button x:Name="CleanNowButton" Content="{DynamicResource SettingsWindow.CleanNow}" Click="Clean_Click" Background="{DynamicResource ColorPrimaryBrush}" Foreground="White" Width="130" HorizontalAlignment="Left" Padding="15,8" Margin="0,0,10,0"/>
                                                <Button x:Name="CleanRamButton" Content="Wyczyść RAM" Click="CleanRam_Click" Background="{DynamicResource ColorPrimaryBrush}" Foreground="White" Width="130" HorizontalAlignment="Left" Padding="15,8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="0,0,12,12" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="© 2026 JGS" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Image Source="logonbg.png" Width="18" Height="18" Opacity="0.6"/>
                        <TextBlock Text="v3.0.1 Stable" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="SplashOverlay" Grid.RowSpan="4" Background="{DynamicResource WindowBackground}" Visibility="Visible" IsHitTestVisible="True" Panel.ZIndex="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="SplashLogo" Source="logonbg.png" Width="120" Height="120"/>
                    <TextBlock Text="ParrotBoost" FontSize="26" FontWeight="Bold" Margin="0,25,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,35,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="12" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="30"/>
    </Grid>
</Window>
